[Unit]
Description=MeetCal API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/meetcal-backend/app
EnvironmentFile=/home/YOUR_LINUX_USER/meetcal-backend/.env
# The crate is named `app` (app/Cargo.toml), so that is the release binary.
ExecStart=/home/YOUR_LINUX_USER/meetcal-backend/app/target/release/app
Restart=unless-stopped
RestartSec=5

[Install]
WantedBy=multi-user.target
