[Unit]
Description=MeetCal API
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=YOUR_LINUX_USER
WorkingDirectory=/home/YOUR_LINUX_USER/meetcal-backend/app
EnvironmentFile=/home/YOUR_LINUX_USER/meetcal-backend/.env
ExecStart=/home/YOUR_LINUX_USER/meetcal-backend/app/target/release/meetcal-backend
Restart=unless-stopped
RestartSec=5

[Install]
WantedBy=multi-user.target
