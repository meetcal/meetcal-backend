APP_DATABASE__PASSWORD="your_password"
POSTGRES_PASSWORD="your_password"
DATABASE_URL="postgres://postgres:your_url_encoded_password@127.0.0.1:5432/meetcal"
# Optional read-only API DB role (RLS: SELECT only). Password set by seed_from_convex.
# DATABASE_URL="postgres://meetcal_api:your_url_encoded_password@127.0.0.1:5432/meetcal"

# Optional: how long /meets/package is cached server-side, in seconds (default 3600).
# The package is static during a meet weekend, so a long TTL collapses concurrent
# load into ~one rebuild per meet per hour. Raise it for a known meet weekend.
# APP_PACKAGE_CACHE_TTL_SECS="3600"

# Optional nightly backup upload to Cloudflare R2.
# Uses aws CLI when installed, or the amazon/aws-cli Docker image.
# R2_BUCKET="your-r2-bucket"
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_PREFIX="postgres"
# AWS_ACCESS_KEY_ID="your-r2-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# KEEP_DAYS="30"
# UPTIME_KUMA_PUSH_URL="http://127.0.0.1:3001/api/push/your-backup-monitor-id"

# Optional scraper cron notifications. These mirror the old GitHub Actions
# scraper workflow secrets.
# SLACK_ENTRY_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_MEET_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RANKINGS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RECORDS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RESULTS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_STANDARDS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_URLWATCH_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_WSO_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Optional: meet automation pipeline (scrapers/usaw/meet_automation).
# Stages start-list + schedule from a watched meet page, posts a Slack review,
# and ingests to Postgres + Convex only after you reply "okay" in the thread.
# Reply-based approval needs a bot token + channel; a webhook alone is notify-only.
# SLACK_BOT_TOKEN="xoxb-..."                       # scopes: chat:write, channels:history
# SLACK_MEET_AUTOMATION_CHANNEL="C0123456789"
# SLACK_MEET_AUTOMATION_WEBHOOK_URL="https://hooks.slack.com/services/..."
# MEET_AUTOMATION_PREVIEW_BASE_URL="https://meetcal.example.com/staged"
