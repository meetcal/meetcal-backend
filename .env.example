APP_DATABASE__PASSWORD="your_password"
POSTGRES_PASSWORD="your_password"
DATABASE_URL="postgres://postgres:your_url_encoded_password@127.0.0.1:5432/meetcal"
# Optional read-only API DB role (RLS: SELECT only). Password set by seed_from_convex.
# DATABASE_URL="postgres://meetcal_api:your_url_encoded_password@127.0.0.1:5432/meetcal"

# --- Clerk JWT verification (SECURITY PREREQUISITE) --------------------------
# The API verifies Clerk session JWTs (RS256 via Clerk's JWKS) before trusting
# the `sub` used for Postgres RLS. The master switch + JWKS url + issuer live in
# configuration.yaml (dev/test default: DISABLED). Enable in production by
# creating app/src/configuration.local.yaml (git-ignored):
#
#   auth:
#     jwt_verification_enabled: true
#     jwks_url: "https://<subdomain>.clerk.accounts.dev/.well-known/jwks.json"
#     issuer:   "https://<subdomain>.clerk.accounts.dev"
#
# The bool is intentionally NOT env-overridable (the config crate would need
# try_parsing, which breaks the string settings) — use configuration.local.yaml.

# --- Referral rewards program ------------------------------------------------
# RevenueCat webhook: the static value RevenueCat sends in the Authorization
# header (Project settings -> Integrations -> Webhooks -> Authorization header).
# REVENUECAT_WEBHOOK_SECRET="a-long-random-string"
# Shared secret guarding POST /internal/referrals/run-qualification (the daily
# cron sends it as the X-Internal-Job-Secret header).
# INTERNAL_JOB_SECRET="another-long-random-string"
# Base URL for share links (default https://meetcal.app/invite).
# REFERRAL_SHARE_BASE_URL="https://meetcal.app/invite"
# Base URL the qualification cron curls (default http://127.0.0.1:3000).
# API_BASE_URL="http://127.0.0.1:3000"

# --- Apple promotional-offer signing (iOS reward delivery) -------------------
# From App Store Connect: the subscription-signing key (.p8), its Key ID, the
# app bundle id, and a product_id=offer_id map (one offer per product). If any is
# unset, the iOS claim endpoint returns 503 (never fakes success).
# APPLE_IAP_KEY_ID="ABC123XYZ"
# APPLE_BUNDLE_ID="app.meetcal"
# APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_IAP_OFFER_IDS="com.meetcal.monthly=free_month,com.meetcal.annual=free_month_annual"

# --- Google Play delivery (Android reward delivery) --------------------------
# Service-account JSON (androidpublisher scope) + package name. Uses the LEGACY
# purchases.subscriptions.defer API — flagged for validation before Phase 2. If
# unset, the Android claim endpoint returns 503.
# GOOGLE_PLAY_PACKAGE_NAME="app.meetcal"
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"type":"service_account", ...}'

# Optional: how long /meets/package is cached server-side, in seconds (default 3600).
# The package is static during a meet weekend, so a long TTL collapses concurrent
# load into ~one rebuild per meet per hour. Raise it for a known meet weekend.
# APP_PACKAGE_CACHE_TTL_SECS="3600"

# Optional nightly backup upload to Cloudflare R2.
# Uses aws CLI when installed, or the amazon/aws-cli Docker image.
# R2_BUCKET="your-r2-bucket"
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_PREFIX="postgres"
# AWS_ACCESS_KEY_ID="your-r2-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# KEEP_DAYS="30"
# UPTIME_KUMA_PUSH_URL="http://127.0.0.1:3001/api/push/your-backup-monitor-id"

# Optional scraper cron notifications. These mirror the old GitHub Actions
# scraper workflow secrets.
# SLACK_ENTRY_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_MEET_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RANKINGS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RECORDS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RESULTS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_STANDARDS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_URLWATCH_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_WSO_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Optional: meet automation pipeline (scrapers/usaw/meet_automation).
# Stages start-list + schedule from a watched meet page, posts a Slack review,
# and ingests to Postgres + Convex only after you reply "okay" in the thread.
# Reply-based approval needs a bot token + channel; a webhook alone is notify-only.
# SLACK_BOT_TOKEN="xoxb-..."                       # scopes: chat:write, channels:history
# SLACK_MEET_AUTOMATION_CHANNEL="C0123456789"
# SLACK_MEET_AUTOMATION_WEBHOOK_URL="https://hooks.slack.com/services/..."
# MEET_AUTOMATION_PREVIEW_BASE_URL="https://meetcal.example.com/staged"

# Slack slash commands + approval buttons, handled by the Rust API:
#   POST /scrapers/slack/commands      -> /add /delete /list for managed lists
#   POST /scrapers/slack/interactions  -> Approve/Reject buttons on staged meets
# Both are disabled unless SLACK_SIGNING_SECRET is set. Commands route by name
# (/meet-* edit watches.json, /entries-* edit entries_targets.json), so one
# channel can host both lists. The channel vars below are an optional allowlist.
# These files live on the API server's disk, so edits take effect with no
# redeploy/git pull.
# SLACK_SIGNING_SECRET="your-slack-app-signing-secret"
# SLACK_ENTRIES_CHANNEL="C0SECOND..."                 # channel that manages entry targets
# MEET_AUTOMATION_SLACK_ALLOWED_USERS="U0123,U0456"   # optional user allowlist (both lists)
# MEET_AUTOMATION_WATCHES_PATH="scrapers/usaw/meet_automation/watches.json"      # optional override
# ENTRIES_TARGETS_PATH="scrapers/usaw/entry_scraper/entries_targets.json"        # optional override
# MEET_AUTOMATION_STATE_DIR="scrapers/usaw/meet_automation/state"                # shared with the pipeline (approval decisions)
