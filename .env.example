APP_DATABASE__PASSWORD="your_password"
POSTGRES_PASSWORD="your_password"
DATABASE_URL="postgres://postgres:your_url_encoded_password@127.0.0.1:5432/meetcal"
# Optional read-only API DB role (RLS: SELECT only). Password set by seed_from_convex.
# DATABASE_URL="postgres://meetcal_api:your_url_encoded_password@127.0.0.1:5432/meetcal"

# Optional nightly backup upload to Cloudflare R2.
# Uses aws CLI when installed, or the amazon/aws-cli Docker image.
# R2_BUCKET="your-r2-bucket"
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_PREFIX="postgres"
# AWS_ACCESS_KEY_ID="your-r2-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# KEEP_DAYS="30"
# UPTIME_KUMA_PUSH_URL="https://kuma.example.com/api/push/your-monitor-id"
