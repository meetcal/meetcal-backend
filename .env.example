# Role the API connects as, and its password. Local dev and the test suite use
# the postgres superuser (the default in app/src/configuration.yaml). Production
# must NOT: the superuser bypasses row-level security on saved_sessions /
# user_preferences. deploy-prod.sh defaults APP_DATABASE__USERNAME to
# `meetcal_api` (created by the migrations, SELECT on every table plus its own
# writes on saved_sessions / user_preferences / meets.venue_map_*). Give that
# role a password once -- `ALTER ROLE meetcal_api WITH PASSWORD '...';` -- and
# put it in APP_DATABASE__PASSWORD; POSTGRES_PASSWORD stays the superuser's
# password for scripts/init_db.sh, backups, and the Python ingest.
# APP_DATABASE__USERNAME="meetcal_api"
APP_DATABASE__PASSWORD="your_password"
POSTGRES_PASSWORD="your_password"
DATABASE_URL="postgres://postgres:your_url_encoded_password@127.0.0.1:5432/meetcal"

# Clerk JWT verification for /users/me/* routes. If all three are omitted,
# protected routes fail closed with HTTP 401. Partial configuration stops startup.
CLERK_JWKS_URL="https://clerk.meetcal.app/.well-known/jwks.json"
CLERK_ISSUER="https://clerk.meetcal.app"
# Web origins allowed in the token's `azp` claim. Browser sessions carry `azp`
# and it must be listed here; native app sessions (Expo / iOS / Android) carry
# no `azp` at all and are accepted on signature + issuer + expiry alone.
CLERK_AUTHORIZED_PARTIES="https://meetcal.app,https://www.meetcal.app"
# Optional. When set, every token must carry a matching `aud` claim (missing
# `aud` is a 401), which is what binds an `azp`-less native token to this API.
# Only set it once your Clerk session token template includes `aud`.
# CLERK_AUDIENCE="meetcal-api"

# Optional: how long /meets/package is cached server-side, in seconds (default 3600).
# The package is static during a meet weekend, so a long TTL collapses concurrent
# load into ~one rebuild per meet per hour. Raise it for a known meet weekend.
# APP_PACKAGE_CACHE_TTL_SECS="3600"

# Rate limiting and load shedding (docs/rate-limits.md). Every setting is
# optional; the defaults are in app/src/common/rate_limit.rs.
# Shadow mode (the default) only logs would-be 429s. Flip to true after watching
# the "rate limit exceeded" warnings for a few days.
# APP_RATE_LIMIT__ENFORCE="false"
# API keys for server-side partners, name:secret pairs separated by commas.
# Secrets are 32-256 chars of A-Z a-z 0-9 - _ (e.g. `openssl rand -hex 32`).
# Clients send the secret in `X-MeetCal-Key`. Environment only, never YAML.
# APP_RATE_LIMIT__KEYS="atlas:replace-with-openssl-rand-hex-32"
# Proxies whose X-Forwarded-For is trusted. deploy-prod.sh fills in loopback plus
# the Docker network gateway when this is unset.
# APP_RATE_LIMIT__TRUSTED_PROXIES="127.0.0.0/8,::1/128,172.18.0.1"
# APP_RATE_LIMIT__TRUST_FORWARDED_FOR="true"
# APP_RATE_LIMIT__IP_TOKENS_PER_SECOND="40"
# APP_RATE_LIMIT__IP_BURST="1200"
# APP_RATE_LIMIT__KEY_TOKENS_PER_SECOND="200"
# APP_RATE_LIMIT__KEY_BURST="6000"
# Server-wide in-flight cap; past it requests get 503 + Retry-After: 1.
# Always on, whatever APP_RATE_LIMIT__ENFORCE says.
# APP_RATE_LIMIT__MAX_IN_FLIGHT="500"

# Optional nightly backup upload to Cloudflare R2.
# Uses aws CLI when installed, or the amazon/aws-cli Docker image.
# R2_BUCKET="your-r2-bucket"
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_PREFIX="postgres"
# AWS_ACCESS_KEY_ID="your-r2-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# KEEP_DAYS="30"
# UPTIME_KUMA_PUSH_URL="http://127.0.0.1:3001/api/push/your-backup-monitor-id"

# Optional scraper cron notifications. These mirror the old GitHub Actions
# scraper workflow secrets.
# SLACK_ENTRY_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_MEET_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RANKINGS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RECORDS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_RESULTS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_STANDARDS_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_URLWATCH_WEBHOOK_URL="https://hooks.slack.com/services/..."
# SLACK_WSO_WEBHOOK_URL="https://hooks.slack.com/services/..."

# Optional: meet automation pipeline (scrapers/usaw/meet_automation).
# Stages start-list + schedule from a watched meet page, posts a Slack review,
# and ingests to Postgres only after you reply "okay" in the thread.
# Reply-based approval needs a bot token + channel; a webhook alone is notify-only.
# SLACK_BOT_TOKEN="xoxb-..."                       # scopes: chat:write, channels:history
# SLACK_MEET_AUTOMATION_CHANNEL="C0123456789"
# SLACK_MEET_AUTOMATION_WEBHOOK_URL="https://hooks.slack.com/services/..."
# MEET_AUTOMATION_PREVIEW_BASE_URL="https://meetcal.example.com/staged"

# Slack slash commands + approval buttons, handled by the Rust API:
#   POST /scrapers/slack/commands      -> /add /delete /list for managed lists
#   POST /scrapers/slack/interactions  -> Approve/Reject buttons on staged meets
# Both are disabled unless SLACK_SIGNING_SECRET is set. Commands route by name
# (/meet-* edit watches.json, /entries-* edit entries_targets.json), so one
# channel can host both lists. The channel vars below are an optional allowlist.
# These files live on the API server's disk, so edits take effect with no
# redeploy/git pull.
# SLACK_SIGNING_SECRET="your-slack-app-signing-secret"
# SLACK_ENTRIES_CHANNEL="C0SECOND..."                 # channel that manages entry targets
# MEET_AUTOMATION_SLACK_ALLOWED_USERS="U0123,U0456"   # optional user allowlist (both lists)
# MEET_AUTOMATION_WATCHES_PATH="scrapers/usaw/meet_automation/watches.json"      # optional override
# ENTRIES_TARGETS_PATH="scrapers/usaw/entry_scraper/entries_targets.json"        # optional override
# MEET_AUTOMATION_STATE_DIR="scrapers/usaw/meet_automation/state"                # shared with the pipeline (approval decisions)
